# Copy this file to backend/.env and fill in your keys.
# .env is gitignored — API keys must NEVER appear in frontend code.

# Etherscan API key — primary source of Ethereum transaction history.
# Free tier: 5 calls/sec. Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Alchemy API key — optional, gives cleaner asset-transfer data.
# Get one at https://dashboard.alchemy.com/
ALCHEMY_API_KEY=
