# Copy this file to backend/.env and fill in your keys.
# .env is gitignored — API keys must NEVER appear in frontend code.

# Etherscan API key — primary source of Ethereum transaction history.
# Free tier: 5 calls/sec. Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Alchemy API key — optional, gives cleaner asset-transfer data.
# Get one at https://dashboard.alchemy.com/
ALCHEMY_API_KEY=

# Neo4j connection for the money-flow graph. OPTIONAL: if these are unset or the
# server is unreachable, the tracer falls back to its in-memory graph engine and
# produces identical results, so the demo cannot be broken by a stopped container.
# Defaults match docker-compose.yml, so `docker compose up -d` needs no changes.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vasptrace2026
